#!/usr/bin/env sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
RUST_FORK="/home/benedikt/Git/forks/rust-open-kernel"
if [ "${OPENKERNEL_NIX_SHELL:-0}" != 1 ]; then
    if ! command -v nix >/dev/null 2>&1; then
        printf 'nix is required to run the OpenKernel stage1 compiler\n' >&2
        exit 1
    fi
    exec nix develop "$RUST_FORK" --command env OPENKERNEL_NIX_SHELL=1 "$0" "$@"
fi
BUILD_DIR="$ROOT_DIR/build"
ISO_ROOT="$BUILD_DIR/limine-iso-root"
KERNEL="$BUILD_DIR/open-kernel-limine.elf"
INIT_STAGED="$BUILD_DIR/init.elf"
ISO="$BUILD_DIR/open-kernel-limine.iso"
INIT_MANIFEST="$ROOT_DIR/init/Cargo.toml"
INIT_BINARY="$ROOT_DIR/target/x86_64-unknown-openkernel/release/init"
CONSOLE_MANIFEST="$ROOT_DIR/user-program/Cargo.toml"
CONSOLE_BINARY="$ROOT_DIR/target/x86_64-unknown-openkernel/release/user-program"
OPENKERNEL_STD="${OPENKERNEL_STD:-1}"
OPENKERNEL_RUSTC="${OPENKERNEL_RUSTC:-/home/benedikt/Git/forks/rust-open-kernel/build/x86_64-unknown-linux-gnu/stage1/bin/rustc}"

# PID 1 (init) and the console are std binaries now, so they always need
# the OpenKernel stage1 compiler and its `std` port, regardless of
# OPENKERNEL_STD (which only gates whether the optional std-smoke module
# is also built).
if [ ! -x "$OPENKERNEL_RUSTC" ]; then
    printf 'OpenKernel compiler not found: %s\n' "$OPENKERNEL_RUSTC" >&2
    exit 1
fi

for command in cargo limine ld xorriso; do
    if ! command -v "$command" >/dev/null 2>&1; then
        printf 'Missing required command: %s\n' "$command" >&2
        exit 1
    fi
done

LIMINE_DIR=$(limine --print-datadir)

rm -rf "$ISO_ROOT"
mkdir -p "$BUILD_DIR" "$ISO_ROOT/boot/limine" "$ISO_ROOT/EFI/BOOT"

cargo rustc --manifest-path "$ROOT_DIR/limine-adapter/Cargo.toml" --release \
    --bin limine-adapter -- -C relocation-model=static -C code-model=kernel \
    -C no-redzone=yes -C linker=ld -C link-arg=-melf_x86_64 \
    -C link-arg=-T"$ROOT_DIR/linker-limine.ld" -C link-arg=-nostdlib \
    -C link-arg=-z -C link-arg=max-page-size=0x1000
# This std library must match the stage1 compiler selected above. Rust
# bootstrap requires an explicit stage when CI is set.
(cd "$RUST_FORK" && BOOTSTRAP_SKIP_TARGET_SANITY=1 ./x build --stage 1 library/std --target x86_64-unknown-openkernel)
cargo clean --manifest-path "$INIT_MANIFEST" -p init
RUSTC="$OPENKERNEL_RUSTC" cargo rustc --manifest-path "$INIT_MANIFEST" --release \
    --target x86_64-unknown-openkernel -- -C relocation-model=static -C code-model=small -C linker=ld \
    -C link-arg=-melf_x86_64 -C link-arg=-T"$ROOT_DIR/user-linker.ld" -C link-arg=-nostdlib
cargo clean --manifest-path "$CONSOLE_MANIFEST" -p user-program
RUSTC="$OPENKERNEL_RUSTC" cargo rustc --manifest-path "$CONSOLE_MANIFEST" --release \
    --target x86_64-unknown-openkernel -- -C relocation-model=static -C code-model=small -C linker=ld \
    -C link-arg=-melf_x86_64 -C link-arg=-T"$ROOT_DIR/user-linker.ld" -C link-arg=-nostdlib
if [ "$OPENKERNEL_STD" = 1 ]; then
    cargo clean --manifest-path "$ROOT_DIR/std-program/Cargo.toml" -p openkernel-std-smoke
    RUSTC="$OPENKERNEL_RUSTC" cargo rustc --manifest-path "$ROOT_DIR/std-program/Cargo.toml" --release \
        --target x86_64-unknown-openkernel -- -C relocation-model=static -C code-model=small -C linker=ld \
        -C link-arg=-melf_x86_64 -C link-arg=-T"$ROOT_DIR/user-linker.ld" -C link-arg=-nostdlib
fi
cp "$ROOT_DIR/target/release/limine-adapter" "$KERNEL"
cp "$INIT_BINARY" "$INIT_STAGED"

cp "$KERNEL" "$ISO_ROOT/boot/open-kernel-limine.elf"
cp "$INIT_STAGED" "$ISO_ROOT/boot/init.elf"
cp "$CONSOLE_BINARY" "$ISO_ROOT/boot/console.elf"
cp "$ROOT_DIR/limine.conf" "$ISO_ROOT/boot/limine/limine.conf"
if [ "$OPENKERNEL_STD" = 1 ]; then
    cp "$ROOT_DIR/target/x86_64-unknown-openkernel/release/openkernel-std-smoke" "$ISO_ROOT/boot/std-smoke.elf"
    printf 'module_path: boot():/boot/std-smoke.elf\nmodule_string: std-smoke\n' >> "$ISO_ROOT/boot/limine/limine.conf"
fi
cp "$LIMINE_DIR/limine-bios.sys" "$ISO_ROOT/boot/limine/limine-bios.sys"
cp "$LIMINE_DIR/limine-bios-cd.bin" "$ISO_ROOT/boot/limine/limine-bios-cd.bin"
cp "$LIMINE_DIR/limine-uefi-cd.bin" "$ISO_ROOT/boot/limine/limine-uefi-cd.bin"
cp "$LIMINE_DIR/BOOTX64.EFI" "$ISO_ROOT/EFI/BOOT/BOOTX64.EFI"

xorriso -as mkisofs -R -r -J -b boot/limine/limine-bios-cd.bin -no-emul-boot \
    -boot-load-size 4 -boot-info-table --efi-boot boot/limine/limine-uefi-cd.bin \
    -efi-boot-part --efi-boot-image --protective-msdos-label \
    -o "$ISO" "$ISO_ROOT"
limine bios-install "$ISO"

printf 'Created %s\n' "$ISO"
