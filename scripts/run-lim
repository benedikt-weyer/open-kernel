#!/usr/bin/env sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
SATA_DISK="$ROOT_DIR/build/sata.img"

"$ROOT_DIR/scripts/build-limine-iso"
if [ ! -f "$SATA_DISK" ]; then
    truncate -s 16M "$SATA_DISK"
fi
exec qemu-system-x86_64 -machine q35 -m 128M -boot once=d \
    -drive file="$ROOT_DIR/build/open-kernel-limine.iso",media=cdrom,readonly=on,format=raw \
    -device virtio-rng-pci,disable-modern=on \
    -drive if=none,file="$SATA_DISK",format=raw,id=sata0 \
    -device ide-hd,drive=sata0,bus=ide.1,unit=0 \
    "$@"
